# =============================================================================
# EPP SafetyVision - Configuración de Entorno y Seguridad
# =============================================================================

# Secreto Criptográfico para Firmado de Tokens JWT (HS256)
# IMPORTANTE: Reemplace este valor por una clave aleatoria de al menos 32 caracteres.
# Generar una clave segura en PowerShell/Bash ejecutando:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Si se deja vacío o no se define, el sistema genera automáticamente una clave segura en memoria.
SECRET_KEY=

# Tiempo de expiración del token de sesión en minutos (720 min = 12 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Orígenes Permitidos para CORS y Conexiones WebSockets (separados por coma)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Tamaño máximo de subida de video en bytes (209715200 = 200 MB)
MAX_UPLOAD_SIZE_BYTES=209715200

# Parámetros del Motor de Detección YOLO
CONF_THRESHOLD=0.50
INCIDENT_COOLDOWN_SECONDS=60.0
